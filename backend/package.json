{
  "name": "@freshshop/backend",
  "version": "0.0.1",
  "description": "Medusa backend for the FresshShop supplement store (copied from shopStore medusa-dtc/apps/backend).",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "setup:local": "node scripts/local.mjs setup",
    "start:local": "node scripts/local.mjs dev",
    "import:metagenics": "node scripts/import-metagenics.mjs",
    "import:reviews": "node scripts/import-reviews.mjs",
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.2",
    "@medusajs/admin-shared": "2.22.2",
    "@medusajs/caching": "2.22.2",
    "@medusajs/cli": "2.22.2",
    "@medusajs/dashboard": "2.22.2",
    "@medusajs/draft-order": "2.22.2",
    "@medusajs/framework": "2.22.2",
    "@medusajs/medusa": "2.22.2",
    "@medusajs/ui": "4.2.9",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.2",
    "@medusajs/test-utils": "2.22.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "pg": "8.16.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.23.4"
  },
